# ==============================================================================
# SOLA VACATION RENTALS — MASTER ENVIRONMENT VARIABLES INVENTORY
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Cloudflare Pages / Vite)
# Set in admin-app, owner-app, customer-app environment settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://sola-backend-api.essxm01.workers.dev/api/v1

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Cloudflare Workers / Backend)
# Set in backend environment secrets (Wrangler / Cloudflare Workers Secrets)
# NEVER expose these in frontend client bundles!
# ------------------------------------------------------------------------------

# Database Connection (Supabase PostgreSQL Transaction Pooler port 6543)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres

# Supabase API Credentials
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cryptographic JWT Tokens Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Payment Gateway (Paymob / Local Gateway)
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# Server Configuration
PORT=4000
NODE_ENV=production
