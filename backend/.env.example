# Sola Vacation Rentals — Backend Environment Template
# Location: backend/.env.example
# Security Notice: NEVER put actual passwords or secret keys in this template file!

NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection String (Supabase Session Pooler URI on Port 6543)
DATABASE_URL=REPLACE_WITH_SUPABASE_SESSION_POOLER_URL

# Supabase Production Project Configuration
SUPABASE_URL=https://zrbmbjgcsowfqklmxbyn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Object Storage Configuration
OBJECT_STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=property-media
STORAGE_CDN_HOST=http://localhost:4000/storage

# JWT Cryptographic Secret Keys
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET

# CORS Whitelist Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
